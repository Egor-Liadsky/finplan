# Образец переменных окружения finplan. Скопировать в .env для локальной
# разработки. Значения секретов ниже — безопасные заглушки, не настоящие
# токены. Полное описание переменных — docs/architecture.md, раздел 10.1.

APP_ENV=local
APP_DEBUG=true
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO
LOG_FORMAT=console
# Хосты `postgres` и `redis` — имена сервисов docker-compose: файл копируется
# в .env, который читают контейнеры (env_file в docker-compose.yml). Для
# запуска процессов вне Docker, через `uv run`, замените оба хоста на localhost
#
# Три роли БД (docs/architecture.md, раздел 4.5): RLS действует только для
# ролей без BYPASSRLS и без прав владельца, поэтому api/bot, worker и
# миграции подключаются разными ролями с разными правами. Пароли ниже равны
# именам ролей и годятся только для локальной разработки — их создаёт
# скрипт инициализации контейнера postgres в docker-compose.yml.
#
# finplan_app: LOGIN NOBYPASSRLS — под RLS, видит только своего user_id
DATABASE_URL=postgresql+asyncpg://finplan_app:finplan_app@postgres:5432/finplan
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false
# finplan_worker: LOGIN BYPASSRLS — обрабатывает данные всех пользователей
WORKER_DATABASE_URL=postgresql+asyncpg://finplan_worker:finplan_worker@postgres:5432/finplan
# finplan: владелец схемы, таблиц и функций — только для Alembic
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://finplan:finplan@postgres:5432/finplan
# Отсутствие переключает FSM бота на хранение в памяти
REDIS_URL=redis://redis:6379/0
# Заглушка: настоящий токен бота получить у @BotFather. Формат обязан быть
# синтаксически валидным (id:hash), иначе aiogram не создаст Bot() и процесс
# не стартует
TELEGRAM_BOT_TOKEN=123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
TELEGRAM_MODE=polling
# Обязателен при TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_URL=
# Секретный сегмент пути вебхука
TELEGRAM_WEBHOOK_PATH=
# Значение заголовка X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Список секретов через запятую; первый используется для подписи JWT
JWT_SECRETS=changeme
JWT_ACCESS_TTL=900
REFRESH_TTL=2592000
# Срок одноразовой ссылки входа из бота, секунды
LOGIN_TICKET_TTL=300
# Допустимый возраст auth_date виджета входа Telegram, секунды
TELEGRAM_AUTH_MAX_AGE=300
# Список origin SPA через запятую
CORS_ORIGINS=http://localhost:5173
DEFAULT_BASE_CURRENCY=RUB
DEFAULT_TIMEZONE=Europe/Moscow
# cbr или none
FX_PROVIDER=cbr
FX_FETCH_CRON=0 6 * * *
# Позволяет выключить планировщик в api и bot
SCHEDULER_ENABLED=true
# Пусто — Sentry выключен
SENTRY_DSN=
